# --- database ---
POSTGRES_USER=spry
POSTGRES_PASSWORD=spry
POSTGRES_DB=spry
POSTGRES_PORT=5432

# --- backend ---
DATABASE_URL=postgresql+asyncpg://spry:spry@db:5432/spry
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- aws (make deploy-backend / deploy-frontend / domain) ---
# Everything lands in us-east-1, tagged PROJECT_NAME=<PROJECT_NAME>. Every
# other knob has a default in the scripts or templates and can still be set
# here to override it.
AWS_REGION=us-east-1
PROJECT_NAME=spry
# Blank keys fall back to AWS_PROFILE, SSO, or an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# The deployed frontend's origin, once it has one.
API_CORS_ORIGINS=*

# --- Lab 6: the agenda parser (make deploy-ai) ---
# anthropic.claude-opus-5-5 | anthropic.claude-haiku-5-5 | us.amazon.nova-micro-v1:0
PARSER_MODEL=anthropic.claude-opus-5-5
# The monthly $5 budget alarm goes here; empty skips it.
BUDGET_EMAIL=

# --- written by the scripts, not by hand ---
# make deploy-backend: the function URL. make deploy-frontend builds against it.
BACKEND_URL=
# make domain DOMAIN=app.example.com: the frontend's custom domain.
DOMAIN_NAME=
# make deploy-ai: the parser's function URL. make deploy-frontend builds against it.
PARSER_URL=
