{
  "hosting": {
    "public": "frontend/out",
    "cleanUrls": true,
    "ignore": ["firebase.json", "firebase.cloudrun.json", "**/.*"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "spry-api", "region": "us-central1" }
      }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      }
    ]
  }
}
